# --- PocketBase -------------------------------------------------------------
# Public URL of the API (used in e-mails: verification / password reset)
SHOPBANDIT_PUBLIC_URL=https://shop.example.com
# Header with the client IP set by your reverse proxy (needed for rate limits)
SHOPBANDIT_TRUSTED_PROXY_HEADER=X-Real-IP
# Allowed UnifiedPush endpoint hosts, comma separated (empty = any https host)
SHOPBANDIT_PUSH_HOSTS=push.example.com,ntfy.sh
# Optional: deliver pushes for your own ntfy directly (public=local), e.g. when
# the server cannot reach its own public hostname (no hairpin NAT)
SHOPBANDIT_PUSH_LOCAL=
# SMTP for verification + password reset mails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SENDER=shopbandit@example.com
# Image tag (release version, e.g. 1.0.0)
SHOPBANDIT_VERSION=latest

# --- ntfy (UnifiedPush distributor server) -----------------------------------
NTFY_BASE_URL=https://push.example.com
